{
  "expo": {
    "name": "FinanceFlow",
    "slug": "secretsapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "secretsapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png",
        "backgroundColor": "#74b9ff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.taimoordev.SecretsApp",
      "permissions": [
        "NOTIFICATIONS",
        "VIBRATE",
        "WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app-icon.png",
          "color": "#74b9ff"
        }
      ],
      "expo-background-fetch"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "656aeb47-c697-4de7-a227-c348c625cfaa"
      }
    },
    "eas": {
      "projectId": "656aeb47-c697-4de7-a227-c348c625cfaa"
    },
    "expoGo": {
      "enabled": false
    },
    "owner": "financeflows"
  }
}

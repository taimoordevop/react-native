rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    /** Returns true if the request is made by an authenticated user */
    function isAuth() {
      return request.auth != null;
    }

    /** Returns true if the authenticated user owns the document */
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    /** Returns true if the authenticated user has the 'admin' role */
    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    /** Only allow fields that are in the permitted set (no role/reputation escalation) */
    function onlyAllowedFields(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ── Users collection ──────────────────────────────────────────────────────
    match /users/{uid} {
      // Any authenticated user can read their own document; admins can read all
      allow read: if isOwner(uid) || isAdmin();

      // Only the owner can create their own document (set during signUp)
      allow create: if isOwner(uid);

      // Owner can update only safe fields — cannot self-promote role or reputation
      allow update: if isOwner(uid) &&
        onlyAllowedFields([
          'displayName', 'photoURL', 'bio', 'pubgId', 'pubgNickname',
          'pubgServer', 'fcmToken', 'onboardingCompleted', 'updatedAt'
        ]);

      // Admins can update any user field (for moderation)
      allow update: if isAdmin();

      // No one can delete a user document from the client
      allow delete: if false;
    }

    // ── Listings collection ───────────────────────────────────────────────────
    match /listings/{listingId} {
      // Anyone authenticated can read listings
      allow read: if isAuth();

      // Only suppliers (and admins) can create listings
      allow create: if isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['supplier', 'admin'];

      // Only the listing owner or admin can update/delete
      allow update, delete: if isAuth() &&
        (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // ── Orders collection ─────────────────────────────────────────────────────
    match /orders/{orderId} {
      // Buyer, seller, or admin can read an order
      allow read: if isAuth() &&
        (resource.data.buyerId == request.auth.uid ||
         resource.data.sellerId == request.auth.uid ||
         isAdmin());

      // Any authenticated buyer can create an order
      allow create: if isAuth();

      // Buyer or seller can update order status; admin can always update
      allow update: if isAuth() &&
        (resource.data.buyerId == request.auth.uid ||
         resource.data.sellerId == request.auth.uid ||
         isAdmin());

      allow delete: if false;
    }

    // ── Proofs collection ─────────────────────────────────────────────────────
    match /proofs/{proofId} {
      allow read: if isAuth() &&
        (resource.data.sellerId == request.auth.uid ||
         resource.data.buyerId == request.auth.uid ||
         isAdmin());

      // Only the seller of the linked order can submit proof
      allow create: if isAuth() && request.resource.data.sellerId == request.auth.uid;

      // Seller can update their own proof; admin can update any
      allow update: if isAuth() &&
        (resource.data.sellerId == request.auth.uid || isAdmin());

      allow delete: if false;
    }

    // ── Reviews collection ────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if isAuth();

      // Only the reviewer can create their own review
      allow create: if isAuth() && request.resource.data.reviewerId == request.auth.uid;

      // Reviews are immutable once submitted
      allow update, delete: if false;
    }

    // ── Deny all other collections by default ─────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

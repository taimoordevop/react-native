rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    /** Returns true if the request is made by an authenticated user */
    function isAuth() {
      return request.auth != null;
    }

    /** Returns true if the authenticated user owns the document */
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    /** Returns true if the authenticated user has the 'admin' role. */
    function isAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    /** Returns true if the authenticated user has the 'seller' role. */
    function isSeller() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller';
    }

    /** Only allow fields that are in the permitted set (no reputation escalation) */
    function onlyAllowedFields(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ── Users collection ──────────────────────────────────────────────────────
    match /users/{uid} {
      // Single-document get: allow any authenticated user so buyers and sellers can view details/payouts
      allow get: if isAuth();

      // List/query: allow public access so the client can check username/email uniqueness.
      // App code only reads displayName and email for this purpose.
      allow list: if true;

      // Only the owner can create their own document (written during signUp)
      allow create: if isOwner(uid);

      // Owner can update safe profile fields + role (needed for onboarding role selection)
      // Reputation, totalPop, isVerified, isBanned are server-only fields
      allow update: if isOwner(uid) &&
        onlyAllowedFields([
          'displayName', 'photoURL', 'bio',
          'pubgId', 'pubgNickname', 'pubgServer',
          'fcmToken', 'onboardingCompleted', 'updatedAt',
          'role', 'paymentDetails', 'whatsappNumber', 'googleDriveFolder',
          'defaultCommissionPer10k'
        ]);

      // Admins can update any user field (for moderation / manual role assignment)
      allow update: if isAdmin();

      // No client-side deletes
      allow delete: if false;
    }

    // ── Listings collection ───────────────────────────────────────────────────
    match /listings/{listingId} {
      // Anyone authenticated can read listings
      allow read: if isAuth();

      // Only suppliers (and admins) can create listings
      allow create: if isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['supplier', 'admin'];

      // Only the listing owner or admin can update/delete
      allow update, delete: if isAuth() &&
        (resource.data.supplierId == request.auth.uid || isAdmin());
    }

    // ── Orders collection ─────────────────────────────────────────────────────
    match /orders/{orderId} {
      // Single-document get: buyer or supplier can read their own order
      allow get: if isAuth() &&
        (resource.data.buyerId == request.auth.uid ||
         resource.data.supplierId == request.auth.uid ||
         ('popSupplierId' in resource.data && resource.data.popSupplierId == request.auth.uid) ||
         isAdmin());

      // List/query: allow any authenticated user — app-side where clauses
      // (buyerId == uid or supplierId == uid) keep data scoped correctly.
      // Firestore cannot evaluate resource.data during collection queries.
      allow list: if isAuth();

      // Any authenticated user can create an order (role guard is in app logic)
      allow create: if isAuth();

      // Buyer, supplier/seller, or admin can update their order.
      // - Buyer writes: buyerPaymentProof (payment screenshots)
      // - Supplier/seller writes: status, proofVideos, supplierPayoutProof
      allow update: if isAuth() &&
        (resource.data.buyerId == request.auth.uid ||
         resource.data.supplierId == request.auth.uid ||
         ('popSupplierId' in resource.data && resource.data.popSupplierId == request.auth.uid) ||
         isAdmin());

      allow delete: if false;
    }

    // ── Proofs collection ─────────────────────────────────────────────────────
    match /proofs/{proofId} {
      allow read: if isAuth() &&
        (resource.data.supplierId == request.auth.uid ||
         resource.data.buyerId == request.auth.uid ||
         isAdmin());

      // Only the supplier of the linked order can submit proof
      allow create: if isAuth() && request.resource.data.supplierId == request.auth.uid;

      // Supplier can update their own proof; admin can update any
      allow update: if isAuth() &&
        (resource.data.supplierId == request.auth.uid || isAdmin());

      allow delete: if false;
    }

    // ── Requests collection ───────────────────────────────────────────────────
    match /requests/{requestId} {
      // All authenticated users can read open requests (buyers browse, suppliers book)
      allow read: if isAuth();

      // Only sellers (and admins) can create requests
      allow create: if isAuth() && (isSeller() || isAdmin());

      // Seller/admin can update any field; any auth user can update only
      // booking-related counters (remainingAmount, status, updatedAt)
      allow update: if isAuth() &&
        (resource.data.sellerId == request.auth.uid || isAdmin() ||
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['remainingAmount', 'status', 'updatedAt']));

      allow delete: if false;
    }

    // ── Bookings collection ───────────────────────────────────────────────────
    match /bookings/{bookingId} {
      // Any authenticated user can read — queries are scoped in app code.
      // (Firestore rejects queries when resource.data checks can't be validated
      //  server-side without a matching where clause on the same field.)
      allow read: if isAuth();

      // Any authenticated user can create their own booking
      allow create: if isAuth() && request.resource.data.supplierId == request.auth.uid;

      // Supplier submits proof; seller accepts/rejects; admin can do anything
      allow update: if isAuth() &&
        (resource.data.supplierId == request.auth.uid ||
         resource.data.sellerId   == request.auth.uid ||
         isAdmin());

      allow delete: if false;
    }

    // ── Reviews collection ────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if isAuth();

      // Only the reviewer can create their own review
      allow create: if isAuth() && request.resource.data.reviewerId == request.auth.uid;

      // Reviews are immutable once submitted
      allow update, delete: if false;
    }

    // ── Transactions collection ───────────────────────────────────────────────
    match /transactions/{txnId} {
      // Seller can read their own transactions
      allow read: if isAuth() &&
        (resource.data.sellerId == request.auth.uid || isAdmin());

      // Seller can create their own transaction records, or a linked order participant can create them on order completion
      allow create: if isAuth() && (
        request.resource.data.sellerId == request.auth.uid ||
        (
          'orderId' in request.resource.data &&
          request.resource.data.orderId != null &&
          request.resource.data.orderId != "" &&
          exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId)) &&
          (
            get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.supplierId == request.auth.uid ||
            (
              'popSupplierId' in get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data &&
              get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.popSupplierId == request.auth.uid
            )
          )
        )
      );

      // Transactions are immutable once created (no updates or deletes)
      allow update, delete: if false;
    }

    // ── Deny all other collections by default ─────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
